+		# An installed game does not ship run_uh as an importable module.
+		# The git lookups below need it, but gitversion.txt does not.
+		uh_path = None
+
+	if uh_path is not None:
+		# Try git describe
+		try:
+			git = "git"
+			if platform.system() == "Windows":
